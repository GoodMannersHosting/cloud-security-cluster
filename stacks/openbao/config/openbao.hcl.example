# Copy to /opt/stacks/openbao/config/openbao.hcl on the server (never commit secrets).
ui = true

api_addr     = "https://keeper.goodmanners.services"
cluster_addr = "http://openbao:8201"

# External plugins are declared below and OpenBao pulls, verifies, and
# extracts them here itself on startup — no manual download/register step.
# ${OPENBAO_PLUGINS_DIR:-./plugins} on the host must be writable (not :ro).
plugin_directory = "/openbao/plugins"

# secrets-aws for vault.aws.SecretBackend in infra/openbao/index.ts.
# sha256sum verified against both the GitHub release tarball and the OCI
# image's linux/amd64 layer for this version — update both if bumping.
plugin "secret" "aws" {
  image       = "ghcr.io/openbao/openbao-plugin-secrets-aws"
  version     = "v0.3.1"
  binary_name = "openbao-plugin-secrets-aws"
  sha256sum   = "641ae1858c0f660b4c3761286d627e1dcfd33dc35e7c83eb81ca9050b5bdc6d8"
}

listener "tcp" {
  address         = "0.0.0.0:8200"
  cluster_address = "0.0.0.0:8201"
  tls_disable     = true
}

storage "postgresql" {
  connection_url = "postgresql://USER:PASSWORD@postgresql:5432/openbao?sslmode=disable"
  table          = "openbao_kv_store"
  ha_enabled     = "true"
}

seal "awskms" {
  region                = "us-east-1"
  kms_key_id            = "arn:aws:kms:REGION:ACCOUNT:key/KEY_ID"
  shared_creds_filename = "/aws/credentials"
}

# Declarative file audit (required on OpenBao >= 2.3.2; API enable is blocked).
audit "file" "keeper-data" {
  description = "Request audit log on persistent data volume"
  options {
    file_path     = "/openbao/data/audit.log"
    log_raw       = "false"
    hmac_accessor = "true"
    mode          = "0600"
  }
}
