# Route53 hosted zone for goodmanners.services (Route53 console -> Hosted zones).
ROUTE53_HOSTED_ZONE_ID=Z0123456789ABCDEFGHI
AWS_REGION=us-east-1

# Credentials for the webhook, scoped to the single hosted zone above.
# Either fill in a static key pair, or leave both blank and put a profile in
# DNSWEAVER_AWS_CREDS_DIR (e.g. a Roles Anywhere credential_process, as in
# stacks/ops/aws/credentials.example). Static keys take precedence.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_PROFILE=
DNSWEAVER_AWS_CREDS_DIR=/opt/stacks/dnsweaver/aws

# Shared secret between dnsweaver and the webhook: openssl rand -hex 32
DNSWEAVER_WEBHOOK_TOKEN=generate-64-char-hex-token

# Only hostnames matching these globs get a record; everything else is ignored.
DNSWEAVER_DOMAINS=*.goodmanners.services
DNSWEAVER_EXCLUDE_DOMAINS=
# Public IP of keeper, where Traefik terminates TLS.
DNSWEAVER_RECORD_TARGET=5.78.90.164
DNSWEAVER_DEFAULT_TTL=60

# Start true and read the dnsweaver log; flip to false once the proposed
# records match what the zone should hold.
DNSWEAVER_DRY_RUN=true

# false keeps hostnames already in the zone under manual control: dnsweaver
# manages only records it created and marked with an ownership TXT.
DNSWEAVER_ADOPT_EXISTING=false
DNSWEAVER_CLEANUP_ON_STOP=true
DNSWEAVER_CLEANUP_ORPHANS=true

DNSWEAVER_LOG_LEVEL=info
WEBHOOK_LOG_LEVEL=info
