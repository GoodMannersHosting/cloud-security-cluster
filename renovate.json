{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:best-practices",
    ":semanticCommits"
  ],
  "labels": ["dependencies"],
  "semanticCommitType": "chore",
  "semanticCommitScope": "deps",
  "timezone": "America/New_York",
  "schedule": ["before 6am on monday"],
  "prConcurrentLimit": 5,
  "rebaseWhen": "behind-base-branch",
  "dependencyDashboard": true,
  "platformAutomerge": true,
  "lockFileMaintenance": {
    "automerge": true
  },
  "customManagers": [
    {
      "customType": "regex",
      "description": "OpenBao CLI version in bao-sync workflow",
      "managerFilePatterns": ["/^\\.github/workflows/bao-sync\\.yml$/"],
      "matchStrings": ["BAO_CLI_VERSION: \"(?<currentValue>[^\"]+)\""],
      "datasourceTemplate": "github-releases",
      "depNameTemplate": "openbao/openbao",
      "extractVersionTemplate": "^v?(?<version>.+)$"
    }
  ],
  "packageRules": [
    {
      "description": "Wait 7 days before proposing newly published versions",
      "matchPackageNames": ["*"],
      "minimumReleaseAge": "7 days"
    },
    {
      "description": "Group bao-sync workflow GitHub Actions",
      "matchManagers": ["github-actions"],
      "matchFileNames": [".github/workflows/bao-sync.yml"],
      "groupName": "bao-sync workflow",
      "groupSlug": "bao-sync-workflow",
      "minimumReleaseAge": "7 days"
    },
    {
      "description": "Group aws-infra workflow GitHub Actions",
      "matchManagers": ["github-actions"],
      "matchFileNames": [".github/workflows/aws-infra.yml"],
      "groupName": "aws-infra workflow",
      "groupSlug": "aws-infra-workflow",
      "minimumReleaseAge": "7 days"
    },
    {
      "description": "Group keeper-aws-infra npm dependencies",
      "matchManagers": ["npm"],
      "matchFileNames": ["infra/aws/**"],
      "groupName": "keeper-aws-infra",
      "groupSlug": "keeper-aws-infra",
      "minimumReleaseAge": "7 days"
    },
    {
      "description": "Group OpenBao CLI pin in bao-sync workflow",
      "matchManagers": ["custom.regex"],
      "matchFileNames": [".github/workflows/bao-sync.yml"],
      "groupName": "bao-sync workflow",
      "groupSlug": "bao-sync-workflow",
      "minimumReleaseAge": "7 days"
    },
    {
      "matchUpdateTypes": ["minor", "patch", "pin", "digest"],
      "automerge": true,
      "minimumReleaseAge": "7 days"
    },
    {
      "description": "Major updates require manual review before deploy",
      "matchUpdateTypes": ["major"],
      "automerge": false,
      "minimumReleaseAge": "7 days"
    },
    {
      "description": "Pin Docker images to SHA digests for immutable deploys",
      "matchDatasources": ["docker"],
      "pinDigests": true,
      "minimumReleaseAge": "7 days"
    },
    {
      "description": "Ignore floating latest tags on socket-proxy and similar",
      "matchDatasources": ["docker"],
      "matchCurrentValue": "latest",
      "enabled": false,
      "minimumReleaseAge": "7 days"
    },
    {
      "description": "Authentik publishes calendar versions",
      "matchPackageNames": ["ghcr.io/goauthentik/server"],
      "versioning": "regex:^(?<major>\\d{4})\\.(?<minor>\\d+)\\.(?<patch>\\d+)(?<compatibility>.*)?$",
      "minimumReleaseAge": "7 days"
    },
    {
      "description": "Group container updates per Compose stack",
      "matchManagers": ["docker-compose"],
      "matchFileNames": ["stacks/traefik/**"],
      "groupName": "traefik stack",
      "groupSlug": "stack-traefik",
      "minimumReleaseAge": "7 days"
    },
    {
      "description": "Group container updates per Compose stack",
      "matchManagers": ["docker-compose"],
      "matchFileNames": ["stacks/authentik/**"],
      "groupName": "authentik stack",
      "groupSlug": "stack-authentik",
      "minimumReleaseAge": "7 days"
    },
    {
      "description": "Group container updates per Compose stack",
      "matchManagers": ["docker-compose"],
      "matchFileNames": ["stacks/openbao/**"],
      "groupName": "openbao stack",
      "groupSlug": "stack-openbao",
      "minimumReleaseAge": "7 days"
    },
    {
      "description": "Group container updates per Compose stack",
      "matchManagers": ["docker-compose"],
      "matchFileNames": ["stacks/doco-cd/**"],
      "groupName": "doco-cd stack",
      "groupSlug": "stack-doco-cd",
      "minimumReleaseAge": "7 days"
    },
    {
      "description": "Group container updates per Compose stack",
      "matchManagers": ["docker-compose"],
      "matchFileNames": ["stacks/postgres/**"],
      "groupName": "postgres stack",
      "groupSlug": "stack-postgres",
      "minimumReleaseAge": "7 days"
    },
    {
      "description": "Group container updates per Compose stack",
      "matchManagers": ["docker-compose"],
      "matchFileNames": ["stacks/powerdns/**"],
      "groupName": "powerdns stack",
      "groupSlug": "stack-powerdns",
      "minimumReleaseAge": "7 days"
    },
    {
      "description": "Group container updates per Compose stack",
      "matchManagers": ["docker-compose"],
      "matchFileNames": ["stacks/dnsweaver/**"],
      "groupName": "dnsweaver stack",
      "groupSlug": "stack-dnsweaver",
      "minimumReleaseAge": "7 days"
    },
    {
      "description": "Group container updates per Compose stack",
      "matchManagers": ["docker-compose"],
      "matchFileNames": ["stacks/alloy/**"],
      "groupName": "alloy stack",
      "groupSlug": "stack-alloy",
      "minimumReleaseAge": "7 days"
    }
  ]
}
